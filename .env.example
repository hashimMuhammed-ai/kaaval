# Application
NODE_ENV=development
PORT=3000
APP_DOMAIN=caregiver.local

# PostgreSQL with PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=caregiver_db
DB_SSL=false

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-token-replace-in-production
JWT_EXPIRES_IN=1d

# WhatsApp Business Cloud API (Official Meta Graph API)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-waba-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=caregiver-whatsapp-verify-token-change-me
WHATSAPP_APP_SECRET=your-meta-app-secret-for-webhook-hmac
WHATSAPP_DEFAULT_ORIGIN_PHONE=+919876543210
WHATSAPP_DEV_MOCK_MODE=true

