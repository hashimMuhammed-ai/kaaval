# Application
NODE_ENV=development
PORT=3000
APP_DOMAIN=caregiver.local

# PostgreSQL with PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=caregiver_db
DB_SSL=false

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-token-replace-in-production
JWT_EXPIRES_IN=1d
