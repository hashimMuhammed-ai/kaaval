# ==============================================================================
# Caregiver Agency Platform — Monorepo Root Environment Configuration (.env.example)
# ==============================================================================
# Free-Tier Deployment Configuration (Render + Vercel + Neon + Upstash + Cloudflare R2)

# Server & Runtime
NODE_ENV=production
PORT=3000
BACKEND_URL=https://caregiver-api.onrender.com
FRONTEND_URL=https://caregiver-web.vercel.app
APP_DOMAIN=caregiverplatform.com

# 1. PostgreSQL Database (Neon Serverless Postgres with PostGIS)
DATABASE_URL=postgresql://user:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/caregiver_db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=caregiver_db
DB_SSL=false

# 2. Redis Cache & BullMQ Queue (Upstash Serverless Redis)
REDIS_URL=rediss://default:your-upstash-password@your-upstash-endpoint.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. File & Document Storage (Cloudflare R2 — S3-Compatible Object Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=caregiver-documents
R2_PUBLIC_URL=
STORAGE_DRIVER=r2

# 4. Authentication (JWT)
JWT_SECRET=generate-a-strong-random-secret-key-minimum-32-characters
JWT_EXPIRES_IN=1d

# 5. WhatsApp Business Cloud API (Official Meta Graph API — Test Mode)
WHATSAPP_PHONE_NUMBER_ID=your-meta-test-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=caregiver-whatsapp-verify-token-change-in-production
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=your-meta-app-secret-optional-in-test-mode
WHATSAPP_DEFAULT_ORIGIN_PHONE=+919876543210
WHATSAPP_DEV_MOCK_MODE=false

# 6. Frontend Specific (Vercel)
NEXT_PUBLIC_API_URL=https://caregiver-api.onrender.com/api
NEXT_PUBLIC_APP_DOMAIN=caregiverplatform.com
