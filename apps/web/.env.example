# ==============================================================================
# Caregiver Agency Platform — Frontend Web App Environment Configuration (.env.example)
# ==============================================================================
# In Vercel Project Settings -> Environment Variables, configure the following:

# 1. Backend API Base URL (point to your deployed Render backend service)
# Example: https://caregiver-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://caregiver-api.onrender.com/api

# 2. Base Platform Domain (optional, used for subdomain fallback routing)
NEXT_PUBLIC_APP_DOMAIN=caregiverplatform.com
